{
  "name": "@superdurable/superagent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuperAgent browser application",
  "workspaces": [
    "packages/superagent-ui"
  ],
  "scripts": {
    "build:ui": "npm run build --workspace @superdurable/superagent-ui",
    "start": "npm run build:ui && webpack --config webpack.config.mjs --mode development --watch",
    "build": "npm run build:ui && webpack --config webpack.config.mjs --mode production",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "generate:api": "openapi-ts",
    "lint": "eslint . --max-warnings 0",
    "test:ui": "npm run test --workspace @superdurable/superagent-ui",
    "test:server": "node --test ../script/serve-web.test.mjs",
    "test": "npm run build:ui && npm run test:ui && npm run test:server && vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run build:ui && npm run typecheck --workspace @superdurable/superagent-ui && tsc --noEmit"
  },
  "dependencies": {
    "@superdurable/superagent-ui": "0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/unist": "3.0.3",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "3.9.6",
    "ts-loader": "^9.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "webpack": "^5.84.1",
    "webpack-cli": "^5.1.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
