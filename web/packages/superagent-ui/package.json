{
  "name": "@superdurable/superagent-ui",
  "version": "0.1.0",
  "description": "Transport-free React components for SuperAgent conversations",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/superagent.git",
    "directory": "web/packages/superagent-ui"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^18.2.0",
    "@types/unist": "3.0.3",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
